#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$HOME/agentic/homenews"
COMPOSE_FILE="$PROJECT_DIR/deploy/compose.yaml"
VERSION=$(node -p "require('$PROJECT_DIR/package.json').version")

# Web URL uses the LAN IP so phones/laptops on the same network can reach it.
# Falls back to localhost if the LAN address can't be detected.
WEB_HOST=$(ip -4 -o addr show 2>/dev/null | awk '/inet / && $2 !~ /^lo$/ {print $4}' | cut -d/ -f1 | head -1)
WEB_HOST="${WEB_HOST:-localhost}"

print_urls() {
  echo "  Web: http://${WEB_HOST}:52000"
  echo "  API: http://localhost:52001"
  echo "   DB: localhost:52432"
}

case "${1:-help}" in
  start)
    docker compose -f "$COMPOSE_FILE" up -d --build
    echo "homenews v$VERSION running"
    print_urls
    ;;
  stop)
    docker compose -f "$COMPOSE_FILE" down
    echo "homenews stopped"
    ;;
  restart)
    docker compose -f "$COMPOSE_FILE" restart
    echo "homenews restarted"
    ;;
  logs)
    # Local Docker tail. Works whether Loki is up or down. For LogQL queries
    # against Loki, use logcli or Grafana directly — homenews doesn't own
    # that path on purpose.
    docker compose -f "$COMPOSE_FILE" logs -f "${2:-}"
    ;;
  status)
    docker compose -f "$COMPOSE_FILE" ps
    ;;
  rebuild)
    docker compose -f "$COMPOSE_FILE" up -d --build --force-recreate
    echo "homenews v$VERSION rebuilt and running"
    print_urls
    ;;
  migrate)
    docker exec homenews-api pnpm --filter @homenews/api exec drizzle-kit push
    ;;
  update)
    cd "$PROJECT_DIR"

    echo "==> Pulling latest from main..."
    git pull origin main

    echo "==> Building and starting containers..."
    docker compose -f "$COMPOSE_FILE" up -d --build --force-recreate

    echo "==> Waiting for database..."
    for _ in $(seq 1 30); do
      if docker exec homenews-db-prod pg_isready -U homenews -d homenews_prod > /dev/null 2>&1; then
        break
      fi
      sleep 1
    done

    echo "==> Running database migrations..."
    sleep 2
    docker exec homenews-api pnpm --filter @homenews/api exec drizzle-kit push

    echo ""
    echo "homenews v$VERSION updated and running"
    print_urls
    ;;
  backfill)
    kind="${2:-}"
    case "$kind" in
      embeddings)
        docker exec homenews-api pnpm --filter @homenews/api exec tsx src/db/backfill-embeddings.ts
        ;;
      extraction)
        docker exec homenews-api pnpm --filter @homenews/api exec tsx src/db/backfill-extraction.ts
        ;;
      *)
        echo "Usage: homenews backfill {embeddings|extraction}" >&2
        exit 1
        ;;
    esac
    ;;
  seed)
    target="${2:-}"
    case "$target" in
      feeds)
        docker exec homenews-api pnpm --filter @homenews/api exec tsx src/db/seed.ts
        ;;
      settings)
        docker exec homenews-api pnpm --filter @homenews/api exec tsx src/db/seed-settings.ts
        ;;
      *)
        echo "Usage: homenews seed {feeds|settings}" >&2
        exit 1
        ;;
    esac
    ;;
  version|-v|--version)
    echo "homenews v$VERSION"
    ;;
  *)
    echo "homenews v$VERSION"
    cat <<EOF
Usage: homenews <command>

  start                       build + start the prod stack
  stop                        stop and remove the prod stack
  restart                     restart all services in place
  logs [service]              tail container stdout (local; Loki not required)
  status                      show container state
  rebuild                     force-recreate all services from latest code
  migrate                     run drizzle-kit push against the prod DB (idempotent)
  update                      git pull main, rebuild, run drizzle migrations
  backfill {embeddings|extraction}
                              one-shot scripts (Tasks 71b / 91); run inside api container
  seed {feeds|settings}       first-time seeds; idempotent
  version                     print version

Logs query / dashboards: use logcli or Grafana against the shared Loki.
homenews does not own a Loki access path on purpose.
EOF
    ;;
esac
